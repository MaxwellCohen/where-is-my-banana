{
  "name": "where-is-my-banana",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @wimb/graph-v1 build && pnpm --filter @maxwellcohen/wimb build",
    "build:all": "pnpm build && pnpm --filter @wimb/visualizer build",
    "typecheck": "pnpm --filter @maxwellcohen/wimb exec tsc --noEmit -p . && pnpm --filter @maxwellcohen/wimb exec tsc --noEmit -p ../graph-v1 && pnpm --filter @maxwellcohen/wimb exec tsc --noEmit -p ../visualizer",
    "test": "pnpm --filter @wimb/graph-v1 test && pnpm --filter @maxwellcohen/wimb test",
    "dev": "pnpm --filter @maxwellcohen/wimb dev",
    "viz": "pnpm --filter @wimb/visualizer dev",
    "viz:demo": "node scripts/refresh-viz-demo.mjs",
    "viz:watch": "pnpm --filter @wimb/graph-v1 --filter @wimb/visualizer --parallel dev",
    "viz:deploy": "vercel deploy --prod --yes --scope maxs-projects-e09fe1c2 --project wimb-visualizer"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}

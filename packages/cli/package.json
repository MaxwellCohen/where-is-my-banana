{
  "name": "@maxwellcohen/wimb",
  "version": "0.3.0",
  "description": "Find the import edges that, if cut or made lazy, shrink your first-load client JS the most (Next.js, Vite).",
  "license": "MIT",
  "author": "Maxwell Cohen",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxwellCohen/where-is-my-banana.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MaxwellCohen/where-is-my-banana#readme",
  "bugs": "https://github.com/MaxwellCohen/where-is-my-banana/issues",
  "keywords": [
    "bundle-size",
    "nextjs",
    "vite",
    "performance",
    "lazy-loading",
    "code-splitting",
    "cli"
  ],
  "sideEffects": false,
  "bin": {
    "wimb": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src/data"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm --filter @wimb/graph-v1 build && tsdown && cp ../../README.md README.md",
    "lint:pkg": "publint"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "jiti": "^2.7.0",
    "knip": "^6.16.1",
    "module-replacements": "^2.4.0",
    "oxc-parser": "^0.75.0",
    "oxc-resolver": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@wimb/graph-v1": "workspace:*",
    "publint": "^0.3.0",
    "tsdown": "^0.23.4",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
